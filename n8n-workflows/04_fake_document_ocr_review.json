    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-goog-api-key",
              "value": "={{$env.GEMINI_API_KEY}}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({contents:[{parts:[{text:\"Extract fields visible in this student document. Do not guess missing or unreadable values. Return only JSON with keys name_on_document (string or null), expiry_date (YYYY-MM-DD or null), marks (string or null), ielts_score (string or null), and notes (short string or null).\"},{inline_data:{mime_type:$('One item per document').item.json.filename.toLowerCase().endsWith('.pdf')?'application/pdf':$('One item per document').item.json.filename.toLowerCase().endsWith('.png')?'image/png':'image/jpeg',data:$binary.data.data}}]}],generationConfig:{responseMimeType:'application/json'}}) }}"
      },
      "id": "bde92985-ea97-41db-8108-968d507a4718",
      "name": "Extract fields with Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const doc=$('One item per document').item.json;\nconst raw=($json.candidates?.[0]?.content?.parts||[]).map(p=>p.text||'').join('').trim();\nlet fields={}; try { fields=JSON.parse(raw.replace(/^```json\\s*/i,'').replace(/```$/,'').trim()); } catch { fields={name_on_document:null,expiry_date:null,marks:null,ielts_score:null,notes:'OCR result could not be parsed; staff review required.'}; }\nreturn {json:{document_id:doc.id,...fields}};"
      },
      "id": "92f12d24-9ec7-4a59-b4c4-1d446767fd19",
      "name": "Prepare document review result",
